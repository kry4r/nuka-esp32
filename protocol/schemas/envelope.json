{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/envelope.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "t": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "integer"
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "d": {
      "type": "object"
    }
  },
  "required": [
    "v",
    "t",
    "ts",
    "d"
  ],
  "additionalProperties": true
}
