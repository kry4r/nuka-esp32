{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/assistant-config.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "default": "Nuka"
    },
    "system_prompt": {
      "type": "string",
      "maxLength": 16384
    },
    "lang": {
      "enum": [
        "zh-CN",
        "en"
      ],
      "default": "zh-CN"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "default": 1024
    },
    "llm": {
      "type": "object",
      "properties": {
        "base_url": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://",
              "not": {
                "pattern": "^https?://[^/?#]*@"
              }
            }
          ],
          "default": ""
        },
        "model": {
          "type": "string",
          "default": ""
        },
        "key_secret": {
          "type": "string",
          "default": ""
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "context_window": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 32768
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "context_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "uploads": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 67108864
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "llm"
        ],
        "properties": {
          "llm": {
            "required": [
              "base_url",
              "model"
            ],
            "properties": {
              "base_url": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
