{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/common.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$defs": {
    "no_nul": {
      "pattern": "^[^\\u0000]*$",
      "propertyNames": {
        "pattern": "^[^\\u0000]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/no_nul"
      },
      "items": {
        "$ref": "#/$defs/no_nul"
      }
    }
  }
}
