{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/error.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "error-detail.json"
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": true
}
