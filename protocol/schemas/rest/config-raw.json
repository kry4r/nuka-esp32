{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/config-raw.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "toml": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "mtime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "toml",
    "path",
    "mtime"
  ],
  "additionalProperties": true
}
