{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/ai.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "summary": {
      "$ref": "resources.json#/$defs/usage_today"
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "resources.json#/$defs/ai_account"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "resources.json#/$defs/provider_health"
      }
    }
  },
  "required": [
    "accounts",
    "providers"
  ],
  "additionalProperties": true
}
