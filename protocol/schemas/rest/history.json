{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/history.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "ts": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "ts",
    "series"
  ],
  "additionalProperties": true
}
