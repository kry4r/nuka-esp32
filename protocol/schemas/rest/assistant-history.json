{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/assistant-history.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "assistant-data.json#/$defs/message"
      },
      "maxItems": 100
    },
    "next_before": {
      "$ref": "assistant-data.json#/$defs/id"
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": true
}
