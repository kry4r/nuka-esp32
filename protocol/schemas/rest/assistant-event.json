{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/assistant-event.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "start"
        },
        "data": {
          "type": "object",
          "properties": {
            "dev_id": {
              "$ref": "assistant-data.json#/$defs/id"
            },
            "session_id": {
              "$ref": "assistant-data.json#/$defs/id"
            }
          },
          "required": [
            "dev_id",
            "session_id"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "delta"
        },
        "data": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "tool"
        },
        "data": {
          "type": "object",
          "properties": {
            "tool_call_id": {
              "$ref": "assistant-data.json#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "$ref": "assistant-data.json#/$defs/tool_state"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "tool_call_id",
            "name",
            "state"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "done"
        },
        "data": {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "assistant-data.json#/$defs/id"
            },
            "cancelled": {
              "type": "boolean"
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "error"
        },
        "data": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "event",
        "data"
      ],
      "additionalProperties": true
    }
  ]
}
