{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/token-created.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$",
      "not": {
        "pattern": "[^a-z0-9_-]"
      }
    },
    "name": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "admin",
        "device",
        "agent",
        "hook",
        "notify"
      ]
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "last_used": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "token": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "scope",
    "created",
    "token"
  ],
  "additionalProperties": true
}
