{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/me.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "zone": {
      "enum": [
        "local",
        "lan",
        "public"
      ]
    },
    "csrf": {
      "type": "string"
    },
    "features": {
      "$ref": "../device-data.json#/$defs/features"
    },
    "lang": {
      "enum": [
        "zh-CN",
        "en"
      ]
    }
  },
  "required": [
    "zone",
    "csrf",
    "features",
    "lang"
  ],
  "additionalProperties": true
}
