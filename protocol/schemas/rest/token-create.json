{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/rest/token-create.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "admin",
        "device",
        "agent",
        "hook",
        "notify"
      ]
    }
  },
  "required": [
    "name",
    "scope"
  ],
  "additionalProperties": true
}
