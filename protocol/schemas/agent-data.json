{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuka.example.com/protocol/schemas/agent-data.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$defs": {
    "hello": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$",
          "not": {
            "pattern": "[^a-z0-9_-]"
          }
        },
        "name": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "ver": {
          "type": "string"
        },
        "proto": {
          "const": 1
        },
        "caps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "agent_id",
        "name",
        "os",
        "ver",
        "proto",
        "caps"
      ],
      "additionalProperties": true
    },
    "intervals": {
      "type": "object",
      "properties": {
        "host_fast": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "host_slow": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "disk": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "host_fast",
        "host_slow",
        "disk"
      ],
      "additionalProperties": true
    },
    "welcome": {
      "type": "object",
      "properties": {
        "hub_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$",
          "not": {
            "pattern": "[^a-z0-9_-]"
          }
        },
        "intervals": {
          "$ref": "agent-data.json#/$defs/intervals"
        }
      },
      "required": [
        "hub_id",
        "intervals"
      ],
      "additionalProperties": true
    },
    "host.sample": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "cpu": {
          "$ref": "rest/resources.json#/$defs/cpu"
        },
        "gpus": {
          "type": "array",
          "items": {
            "$ref": "rest/resources.json#/$defs/gpu"
          }
        },
        "mem": {
          "$ref": "rest/resources.json#/$defs/mem"
        },
        "disks": {
          "type": "array",
          "items": {
            "$ref": "rest/resources.json#/$defs/disk"
          }
        },
        "net": {
          "$ref": "rest/resources.json#/$defs/net"
        },
        "fans": {
          "type": "array",
          "items": {
            "$ref": "rest/resources.json#/$defs/fan"
          }
        },
        "temps": {
          "type": "array",
          "items": {
            "$ref": "rest/resources.json#/$defs/temp"
          }
        },
        "bat": {
          "$ref": "rest/resources.json#/$defs/battery"
        },
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "ok",
              "degraded",
              "error",
              "disabled"
            ]
          }
        }
      },
      "required": [
        "name",
        "online"
      ],
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "role"
            ]
          }
        ]
      }
    },
    "media_item": {
      "type": "object",
      "properties": {
        "src_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$",
          "not": {
            "pattern": "[^a-z0-9_-]"
          }
        },
        "host": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "album": {
          "type": "string"
        },
        "state": {
          "enum": [
            "playing",
            "paused",
            "stopped"
          ]
        },
        "pos_s": {
          "type": "number",
          "minimum": 0
        },
        "dur_s": {
          "type": "number",
          "minimum": 0
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "can": {
          "$ref": "device-data.json#/$defs/media_can"
        },
        "cover_b64": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "src_id",
        "host",
        "app",
        "state",
        "can"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "pos_s": [
          "at"
        ]
      }
    },
    "media.state": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "agent-data.json#/$defs/media_item"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": true
    }
  }
}
